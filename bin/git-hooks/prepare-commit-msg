#!/bin/bash
# Git hook: prepare-commit-msg
# Detecta el tipo de cambio (feat, fix, BREAKING) y sugerencias para versioning
# Se ejecuta automáticamente al preparar el mensaje de commit

set -e

COMMIT_MSG_FILE=$1
COMMIT_SOURCE=$2

# Solo procesar commits normales (no merge, squash, etc)
if [[ "$COMMIT_SOURCE" != "" && "$COMMIT_SOURCE" != "message" ]]; then
    exit 0
fi

# Función para colorear output
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

# Leer cambios staged
STAGED_FILES=$(git diff --cached --name-only)
COMMIT_MSG=$(head -n 1 "$COMMIT_MSG_FILE" 2>/dev/null || echo "")

# Determinar tipo de cambio
DETECTED_TYPE=""
if echo "$STAGED_FILES" | grep -qE '^(app|src|packages)/' && ! echo "$STAGED_FILES" | grep -qE '^\.(md|docs)/'; then
    # Hay cambios en código (no documentación)
    if [[ "$COMMIT_MSG" =~ ^feat:? ]]; then
        DETECTED_TYPE="feat"
    elif [[ "$COMMIT_MSG" =~ ^fix:? ]]; then
        DETECTED_TYPE="fix"
    elif [[ "$COMMIT_MSG" =~ BREAKING.CHANGE ]]; then
        DETECTED_TYPE="BREAKING"
    fi
fi

# Solo si detectamos tipo y el hook está habilitado
if [[ -n "$DETECTED_TYPE" && -f ".git/hooks/enable-version-bump" ]]; then
    echo ""
    echo -e "${BLUE}ℹ️  Tipo de cambio detectado: ${YELLOW}$DETECTED_TYPE${NC}"

    case "$DETECTED_TYPE" in
        feat)
            echo -e "💡 ${GREEN}Sugerencia: considere bumpar MINOR version${NC}"
            echo -e "   Comando: ${YELLOW}php artisan app:bump-version minor${NC}"
            ;;
        fix)
            echo -e "💡 ${GREEN}Sugerencia: considere bumpar PATCH version${NC}"
            echo -e "   Comando: ${YELLOW}php artisan app:bump-version patch${NC}"
            ;;
        BREAKING)
            echo -e "⚠️  ${RED}BREAKING CHANGE detectado!${NC}"
            echo -e "   Comando recomendado: ${YELLOW}php artisan app:bump-version major${NC}"
            ;;
    esac
    echo ""
fi

exit 0
