APP_NAME="CodeRED Platform"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090
APP_TIMEZONE=America/Lima
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_PE

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=codered
DB_USERNAME=codered
DB_PASSWORD="Cambiar_Contraseña"
POSTGRES_DB=codered
POSTGRES_USER=codered
POSTGRES_PASSWORD="Cambiar_Contraseña"

CACHE_STORE=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
QUEUE_CONNECTION=redis
REDIS_QUEUE_RETRY_AFTER=172900
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_USERNAME=
REDIS_PASSWORD=
REDIS_PORT=6379
REDIS_DB=0
REDIS_CACHE_DB=1

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
AGENCY_BACKUP_DISK=local
AGENCY_BACKUP_MAXIMUM=10
AGENCY_BACKUP_RETENTION_DAYS=30
AGENCY_BACKUP_AUTO_CLEANUP=false
RUC_ENABLED=true
RUC_CACHE_ENABLED=true
RUC_CACHE_TTL=3600
RUC_RATE_LIMIT_PER_MINUTE=60
RUC_SEARCH_RATE_LIMIT_PER_MINUTE=20
RUC_SEARCH_MIN_LENGTH=3
RUC_SEARCH_MAX_RESULTS=100
# Debe ser <= upload_max_filesize/post_max_size (docker/php/php.ini) y
# client_max_body_size (docker/nginx/default.conf), hoy 5 GB en ambos.
RUC_BACKUP_MAX_UPLOAD_MB=5000

# Formato .rucbackup (contenedor ZIP64 + lotes CSV comprimidos con zstd).
# Ver docs-ruc/BACKUP_FORMAT.md.
# RUC_BACKUP_BATCH_SIZE: filas por lote interno. No afecta a la RAM de PHP
# (todo va por streaming), sino a la granularidad del checkpoint: con lotes
# mas pequenos se pierde menos trabajo al reanudar, con lotes mas grandes hay
# menos arranques de proceso. 500000 es el equilibrio medido.
RUC_BACKUP_BATCH_SIZE=500000
RUC_BACKUP_ZSTD_LEVEL=3
RUC_BACKUP_ZSTD_THREADS=0
# Conserva ruc_records_old tras el swap para poder revertir con
# `php artisan ruc:restore-manage --rollback`.
RUC_BACKUP_KEEP_OLD_TABLE=true
UBIGEO_SOURCE=alanube
UBIGEO_ALANUBE_URL=https://developer.alanube.co/v1.0-PER/docs/ubigeo-table
UBIGEO_DOWNLOAD_TIMEOUT=30
UBIGEO_DOWNLOAD_RETRIES=3
UBIGEO_SYNC_ENABLED=true

# ---------------------------------------------------------------------------
# Sesion / cookies / CSRF
# ---------------------------------------------------------------------------
# Dominio productivo: codered.lat. Durante la transicion desde codered.host se
# mantiene platform.codered.host en las listas de origenes permitidos para no
# cortar clientes ya desplegados (extension Chrome, integraciones n8n).
#
# SESSION_DOMAIN controla el atributo Domain= de la cookie de sesion y NO admite
# dos dominios a la vez: debe coincidir con el dominio por el que realmente se
# navega. En produccion use ".codered.lat"; en local dejelo en null para que el
# navegador use el host exacto (localhost/127.0.0.1) sin romper el CSRF.
# Un SESSION_DOMAIN=.codered.host servido en platform.codered.lat provoca
# error 419 "Page Expired" en Livewire/POST porque el navegador descarta la cookie.
SANCTUM_STATEFUL_DOMAINS=platform.codered.lat,platform.codered.host,localhost:8090,127.0.0.1:8090,192.168.18.124:8090,chrome-extension://jpfcfljmbaijaajjdhblinjgblnfpign
SESSION_DOMAIN=null

# En produccion (HTTPS detras de Cloudflare Tunnel + nginx) ponga true.
# En local sobre http:// DEBE quedar false o no habra sesion.
SESSION_SECURE_COOKIE=false

DEV_ADMIN_NAME="Admin"
DEV_ADMIN_EMAIL=admin@codered.lat
DEV_ADMIN_PASSWORD="Cambiar_Contraseña"

VITE_APP_NAME="CodeRED Platform"

API_ENABLED=true
API_VERSION=v1
API_DOCS_ENABLED=true
API_DOCS_REQUIRE_AUTH=true
API_DOCS_PUBLIC=false
API_RATE_LIMIT_PER_MINUTE=60
API_MOBILE_RATE_LIMIT_PER_MINUTE=15
# CORS. En produccion incluya https://platform.codered.lat y, mientras dure la
# transicion, https://platform.codered.host (ver Install_CodeRED-Platform.sh).
API_ALLOWED_ORIGINS=http://localhost:8090
API_DEFAULT_TOKEN_EXPIRATION_DAYS=90
API_MAX_PER_PAGE=100
API_AGENCY_SCHEMA_VERSION=2
API_AGENCY_CHANGES_DEFAULT_LIMIT=100
API_AGENCY_CHANGES_MAX_LIMIT=500
API_AGENCY_CHANGELOG_RETENTION_DAYS=180
API_ETAG_ENABLED=true
API_LAST_MODIFIED_ENABLED=true

AGENCY_API_RATE_LIMIT_PER_MINUTE=120
DNI_PERUDEVS_ENABLED=false
DNI_PERUDEVS_BASE_URL=https://api.perudevs.com/api/v1/dni/complete
DNI_PERUDEVS_API_KEY=
DNI_PERUDEVS_TIMEOUT=10
DNI_PERUDEVS_RETRIES=2
DNI_CACHE_TTL=86400
DNI_NOT_FOUND_CACHE_TTL=300
DNI_PERSIST_EXTERNAL_RESULTS=true
DNI_REFRESH_AFTER_DAYS=30
DNI_API_RATE_LIMIT_PER_MINUTE=30

# DNI por nombres (proveedor referencial; requiere verificar términos y disponibilidad del sitio)
DNI_NAME_SEARCH_ENABLED=false
DNI_NAME_SEARCH_CACHE_ENABLED=true
DNI_NAME_SEARCH_CACHE_TTL=86400
DNI_NAME_SEARCH_RATE_LIMIT_PER_MINUTE=10
DNI_NAME_SEARCH_DNIPERU_ENABLED=false
DNI_NAME_SEARCH_DNIPERU_URL=https://dniperu.com/buscar-dni-por-nombre/
DNI_NAME_SEARCH_DNIPERU_TIMEOUT=15
DNI_NAME_SEARCH_DNIPERU_CONNECT_TIMEOUT=5
DNI_NAME_SEARCH_DNIPERU_RETRIES=1
DNI_NAME_SEARCH_DNIPERU_USER_AGENT="CodeRED-Platform/4.x (public-form-client)"


# Conexión de solo lectura opcional para php artisan dni:import-legacy
DNI_LEGACY_DB_HOST=
DNI_LEGACY_DB_PORT=5432
DNI_LEGACY_DB_DATABASE=
DNI_LEGACY_DB_USERNAME=
DNI_LEGACY_DB_PASSWORD=
DNI_LEGACY_DB_SSLMODE=prefer

# Extractor interno de agencias Shalom
SHALOM_EXTRACTOR_ENABLED=true
SHALOM_EXTRACTOR_URL=http://shalom-extractor:3000
SHALOM_EXTRACTOR_TIMEOUT=180
SHALOM_EXTRACTOR_MAX_FILE_MB=10
SHALOM_PAGE_TIMEOUT_MS=120000
SHALOM_EXTRACTOR_DEBUG=false
SHALOM_EXTRACTOR_LOG_SAMPLE_SIZE=3
SHALOM_EXTRACTOR_LOG_FULL_RECORDS=false

# Declaración Jurada Shalom (packages/shalom-declaracion-jurada): app
# Node/React independiente, servida por el servicio "declaracion-jurada"
# del mismo docker-compose y accesible en su propio puerto vía Nginx (ver
# docker/nginx/default.conf). Mantiene su SQLite propio solo para datos de
# negocio (créditos, paquetes, métodos de pago) — YA NO tiene usuarios ni
# contraseñas propias: el login autentica directamente contra la tabla
# `users` de CodeRED Platform (rol Postgres de solo lectura
# declaracion_jurada_ro, ver migración
# 2026_08_13_000001_create_declaracion_jurada_readonly_role) y exige el
# permiso declaracion-jurada.view. También usa un token Sanctum para
# resolver DNIs vía la API de CodeRED en vez de un proveedor externo propio.
# URL pública usada para el enlace de navegación en el panel (Identidad →
# Declaración Jurada). Déjela vacía para ocultar el enlace.
DECLARACION_JURADA_URL=http://localhost:8091
DECLARACION_JURADA_ENCRYPTION_KEY=
DECLARACION_JURADA_COOKIE_SECURE=true
DECLARACION_JURADA_DNI_API_URL=https://api.perudevs.com/api/v1/dni/simple
# Token Sanctum (ability dni:consultar) emitido con:
#   php artisan declaracion-jurada:setup
DECLARACION_JURADA_CODERED_API_TOKEN=
# Password del rol Postgres de solo lectura declaracion_jurada_ro (ver
# ensure_declaracion_jurada_env en update.sh, que la genera si falta).
DECLARACION_JURADA_DB_PASSWORD=

# n8n nativo del compose principal.
# La imagen codered-n8n:2.31.4 se construye localmente desde docker/n8n/Dockerfile.
N8N_VERSION=2.31.4
N8N_HOST=n8n.codered.lat
N8N_EDITOR_BASE_URL=https://n8n.codered.lat/
N8N_WEBHOOK_URL=https://n8n.codered.lat/
N8N_ENCRYPTION_KEY=
N8N_DB_DATABASE=n8n
N8N_DB_USERNAME=n8n
N8N_DB_PASSWORD=

# Integracion opcional n8n + Telegram para solicitudes de tokens API.
# No se usa para Pair Instance del nodo CodeRED Agent.
N8N_INTEGRATION_ENABLED=true
N8N_SHARED_SECRET=
TELEGRAM_TOKEN_REQUESTS_ENABLED=true

# -----------------------------------------------------------------------------
# CodeRED Agent
# -----------------------------------------------------------------------------
# CODERED_AGENT_ENCRYPTION_KEY debe ser criptograficamente segura.
# CODERED_AGENT_LOCAL_API_TOKEN debe ser distinta de la clave de cifrado.
# Nunca suba secretos reales al repositorio.
# Se recomienda generar 32 bytes aleatorios, no 32 caracteres debiles:
#   openssl rand -hex 32
# Cada secreto generado debe tener 64 caracteres hexadecimales.
# Estos valores deben persistir entre actualizaciones. Cambiar
# CODERED_AGENT_ENCRYPTION_KEY sin migracion previa vuelve ilegibles
# /data/agent-identity.json y /data/integration.json.
CODERED_PLATFORM_URL=https://platform.codered.lat
CODERED_AGENT_NAME="CodeRED n8n Agent"
CODERED_AGENT_PUBLIC_URL=https://agent.codered.lat
CODERED_AGENT_ENVIRONMENT=production
CODERED_AGENT_PORT=5680
CODERED_AGENT_DATA_PATH=/data

CODERED_AGENT_ENCRYPTION_KEY=
CODERED_AGENT_LOCAL_API_TOKEN=

CODERED_AGENT_HEARTBEAT_SECONDS=30
CODERED_AGENT_DISCOVERY_SECONDS=300
CODERED_AGENT_REQUEST_TIMEOUT_MS=15000
CODERED_AGENT_LOG_LEVEL=info

# CodeRED Agent local API para contenedores n8n.
# CODERED_AGENT_LOCAL_API_TOKEN debe tener el mismo valor en n8n y codered-agent.
# No use localhost desde n8n cuando ambos servicios comparten red Docker.
CODERED_AGENT_LOCAL_URL=http://codered-agent:5680

# Notificaciones de nuevas solicitudes de token hacia n8n/Telegram
N8N_TOKEN_REQUEST_NOTIFICATIONS=true
N8N_TOKEN_REQUEST_WEBHOOK_URL=https://n8n.codered.lat/webhook/codered-events
N8N_TOKEN_REQUEST_WEBHOOK_SECRET=
N8N_TOKEN_REQUEST_WEBHOOK_TIMEOUT=10

CODERED_SUPPORT_EMAIL=support@codered.lat
CODERED_LEGAL_NAME="CodeRED Platform"
CODERED_LEGAL_COUNTRY="Perú"
CODERED_PRIVACY_UPDATED_AT=2026-08-02

# Token Request Encryption Keys
# These keys are used to encrypt sensitive data in token requests (names, emails, phone numbers, tokens).
# Generate with: php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
# For blind index key use: php -r "echo hash_hmac('sha256', 'blind-index', bin2hex(random_bytes(32)), false).PHP_EOL;"
# Keep these values secure and never share them.
TOKEN_REQUEST_DATA_ENCRYPTION_KEY=
TOKEN_REQUEST_BLIND_INDEX_KEY=

# Notificaciones push (Firebase Cloud Messaging)
# La credencial de servicio NUNCA se versiona ni entra en la imagen Docker:
# vive en el host y se monta de solo lectura. FIREBASE_CREDENTIALS_HOST es la
# ruta en el host; FIREBASE_CREDENTIALS es la ruta dentro del contenedor.
# Procedimiento completo y rotacion: docs/FIREBASE_SETUP.md
FIREBASE_CREDENTIALS_HOST=/home/codered/secrets/firebase-adminsdk.json
FIREBASE_CREDENTIALS=/var/www/secrets/firebase-adminsdk.json
# En false el historial sigue funcionando; solo deja de sonar el telefono.
FIREBASE_PUSH_ENABLED=true

# Sesiones de los clientes oficiales (Platform, Mobile, Desktop).
# El access token es corto y se renueva con el refresh token; ver docs/AUTHENTICATION.md.
CLIENT_SESSION_ACCESS_TTL_MINUTES=15
CLIENT_SESSION_REFRESH_TTL_DAYS=30
CLIENT_SESSION_MAX_PER_APP=5
CLIENT_SESSION_REVOKE_ON_PASSWORD_CHANGE=true
