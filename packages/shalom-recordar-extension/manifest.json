{
  "manifest_version": 3,
  "name": "Registro de Actividad Shalom",
  "version": "2.1",
  "permissions": ["storage", "unlimitedStorage", "alarms"],
  "host_permissions": ["https://platform.codered.host/*"],
  "icons": {
    "128": "icon128.png"
  },
  "content_scripts": [
    {
      "matches": ["https://sysprovincia2.shalomcontrol.com/*"],
      "js": ["content.js"],
      "all_frames": true 
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon128.png"
  }
}