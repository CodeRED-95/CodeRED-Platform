{
  "name": "@codered/chrome-extension",
  "version": "2.6.0",
  "private": true,
  "type": "module",
  "description": "Buscador Shalom Control para Google Chrome.",
  "scripts": {
    "dev": "vite build --watch",
    "build": "node scripts/sync-version.mjs && vite build && vite build --config vite.content.config.ts && node scripts/prepare-dist.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run build:extension && node scripts/package-extension.mjs",
    "validate:extension": "node scripts/validate-extension-build.mjs",
    "build:extension": "npm run build && npm run validate:extension"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/chrome": "^0.0.326",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "chai": "5.2.1"
  }
}
