{
  "name": "@codered/chrome-extension",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Buscador Shalom Control para Google Chrome.",
  "scripts": {
    "dev": "vite build --watch",
    "build": "vite build && node scripts/prepare-dist.mjs",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "npm run build && node scripts/package-extension.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.32.0",
    "@types/chrome": "^0.0.326",
    "@types/jsdom": "^28.0.3",
    "@types/node": "^24.1.0",
    "eslint": "^9.32.0",
    "jsdom": "^26.1.0",
    "prettier": "^3.6.2",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.38.0",
    "vite": "^6.3.5",
    "vitest": "^3.2.4"
  }
}
