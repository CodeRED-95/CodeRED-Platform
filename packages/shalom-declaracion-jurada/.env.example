ADMIN_EMAIL=admin@ejemplo.com
ADMIN_PASSWORD=cambia-esta-clave
APP_ENCRYPTION_KEY=genera-un-secreto-largo-y-aleatorio
DNI_API_URL=https://api.perudevs.com/api/v1/dni/simple
DATABASE_PATH=.data/declaracion-jurada.db
COOKIE_SECURE=false

# Notificaciones de compras y comprobantes.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Verificación de correo: usa "resend" o "mailgun".
EMAIL_PROVIDER=resend
RESEND_API_KEY=
MAILGUN_API_KEY=
MAILGUN_DOMAIN=
MAILGUN_REGION=us
EMAIL_FROM=Declaracion Jurada <no-reply@tu-dominio.com>

# Acceso con Google Identity Services (no requiere Client Secret en esta integración).
GOOGLE_CLIENT_ID=

# Interconectividad con CodeRED Platform (opcional). Cuando se ejecuta como
# el servicio "declaracion-jurada" del docker-compose.yml de CodeRED
# Platform, estas variables las define ese compose automáticamente; solo
# hacen falta aquí para correr este paquete de forma standalone.
# CODERED_API_URL/CODERED_API_TOKEN: si están presentes, las consultas DNI
# se resuelven vía GET {CODERED_API_URL}/api/v1/dni/{dni} (ability
# dni:consultar) en vez de DNI_API_URL/perudevs_api_key.
CODERED_API_URL=
CODERED_API_TOKEN=
# CODERED_DB_*: conexión read-only a la base PostgreSQL de CodeRED Platform,
# usada solo para reconocer (por email) si una cuenta de Declaración Jurada
# corresponde a un usuario existente de la plataforma.
CODERED_DB_HOST=
CODERED_DB_PORT=5432
CODERED_DB_DATABASE=
CODERED_DB_USERNAME=
CODERED_DB_PASSWORD=
