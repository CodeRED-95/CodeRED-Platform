# Declaración Jurada ya no gestiona su propia identidad de usuarios: la
# autenticación (login) valida directamente contra la tabla `users` de
# CodeRED Platform (email + hash bcrypt de `password`), su estado
# (`status = 'active'`, sin `deleted_at`) y el permiso
# `declaracion-jurada.view`. No hay registro, recuperación de contraseña ni
# panel de usuarios propio — todo eso se administra en CodeRED Platform.
# CODERED_DB_* es OBLIGATORIO: sin conexión a esa base, la app no puede
# autenticar a nadie y falla al arrancar.
CODERED_DB_HOST=
CODERED_DB_PORT=5432
CODERED_DB_DATABASE=
# Rol de solo lectura dedicado (creado por la migración
# 2026_08_13_000001_create_declaracion_jurada_readonly_role en el repo raíz
# de CodeRED Platform), NO las credenciales completas de la app.
CODERED_DB_USERNAME=declaracion_jurada_ro
CODERED_DB_PASSWORD=

# Interconectividad de consultas DNI (opcional). Si están presentes, las
# consultas se resuelven vía GET {CODERED_API_URL}/api/v1/dni/{dni} (ability
# dni:consultar) en vez de DNI_API_URL/perudevs_api_key propios.
CODERED_API_URL=
CODERED_API_TOKEN=
# URL pública de CodeRED Platform (para el navegador), usada solo para el
# enlace "Administra tu cuenta en CodeRED Platform" del frontend.
CODERED_PUBLIC_URL=

# Cifra la clave del proveedor DNI propio y el token del bot de Telegram
# guardados en el panel — configuración propia de esta app, no contraseñas
# de usuario (esas nunca se copian ni se re-hashean: viven solo en CodeRED).
APP_ENCRYPTION_KEY=genera-un-secreto-largo-y-aleatorio
DNI_API_URL=https://api.perudevs.com/api/v1/dni/simple
DATABASE_PATH=.data/declaracion-jurada.db
COOKIE_SECURE=false

# Notificaciones de compras y comprobantes.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
