{
  "name": "lannus/ruc-tool",
  "description": "Herramienta CLI standalone para generacion y procesamiento de base de datos RUC",
  "version": "2.2.0",
  "type": "application",
  "license": "MIT",
  "config": {
    "process-timeout": 2000,
    "optimize-autoloader": true,
    "sort-packages": true
  },
  "require": {
    "php": "^8.3",
    "ext-pdo": "*",
    "ext-pdo_pgsql": "*",
    "ext-mbstring": "*",
    "symfony/console": "^7.0",
    "monolog/monolog": "^3.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^11.0",
    "squizlabs/php_codesniffer": "^3.8"
  },
  "autoload": {
    "psr-4": {
      "RucTool\\": "src/"
    }
  },
  "bin": [
    "bin/ruc-tool"
  ],
  "scripts": {
    "test": "phpunit",
    "build": "box compile",
    "lint": "phpcs src"
  }
}
