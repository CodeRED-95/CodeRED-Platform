# Database Configuration
DB_DRIVER=sqlite
DB_HOST=localhost
DB_PORT=5432
DB_NAME=ruc_db
DB_USERNAME=ruc_user
DB_PASSWORD=secret
DB_PATH=~/.ruc-tool/ruc.db

# Application Settings
APP_NAME="RUC Tool"
APP_ENV=production
APP_DEBUG=false

# Paths
BACKUP_DIR=~/.ruc-tool/backups
LOGS_DIR=~/.ruc-tool/logs

# Performance
WORKERS=4
BATCH_SIZE=1000
TIMEOUT=3600
